-- ==========================================
-- 2. LÓGICA DEL AUTO STEAL (DESPUÉS DE LA INTRO)
-- ==========================================
local CONFIG = { AUTO_STEAL_ENABLED = true, RADIUS = 65, HOLD_MIN = 1.3, HOLD_MAX = 2.6, NEAR_TARGET_RANGE = 20, FIRE_RANGE = 12, ENTRY_DELAY = 0.3 }
local v1Progress = 0
local V3New = { busy = false, data = {}, generation = 0 }

local function getPromptCallbacks(prompt, cacheTable)
    local data = cacheTable[prompt]
    if data then return data end
    data = { hold = {}, trigger = {}, ready = true }
    if getconnections then
        for _, conn in ipairs(getconnections(prompt.PromptButtonHoldBegan)) do if conn.Function then table.insert(data.hold, conn.Function) end end
        for _, conn in ipairs(getconnections(prompt.Triggered)) do if conn.Function then table.insert(data.trigger, conn.Function) end end
    end
    cacheTable[prompt] = data
    return data
end

local function getCachedStealPrompt(spawn)
    if not spawn then return nil end
    local promptAttachment = spawn:FindFirstChild("PromptAttachment")
    local candidates = promptAttachment and promptAttachment:GetChildren() or spawn:GetDescendants()
    for _, candidate in ipairs(candidates) do
        if candidate:IsA("ProximityPrompt") and candidate.ActionText and candidate.ActionText:find("Steal") then return candidate end
    end
    return nil
end

local function findNearestPrompt(radius)
    local char = LocalPlayer.Character
    local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso"))
    if not root then return nil end
    local nearest, nearestDistSq = nil, math.huge
    local radiusSq = radius * radius
    local plots = workspace:FindFirstChild("Plots") or workspace
    for _, plot in ipairs(plots:GetChildren()) do
        local sign = plot:FindFirstChild("PlotSign")
        local yourBase = sign and sign:FindFirstChild("YourBase")
        if plot:IsA("Model") and not (yourBase and yourBase:IsA("BillboardGui") and yourBase.Enabled) then
            local pods = plot:FindFirstChild("AnimalPodiums")
            if pods then
                for _, pod in ipairs(pods:GetChildren()) do
                    local spawn = pod:FindFirstChild("Base") and pod.Base:FindFirstChild("Spawn")
                    if spawn then
                        local delta = spawn.Position - root.Position
                        local distanceSq = delta:Dot(delta)
                        if distanceSq <= radiusSq and distanceSq < nearestDistSq then
                            local prompt = getCachedStealPrompt(spawn)
                            if prompt then nearest, nearestDistSq = prompt, distanceSq end
                        end
                    end
                end
            end
        end
    end
    return nearest
end

local function getPromptDistance(prompt)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return math.huge end
    local part = prompt.Parent
    if part and part:IsA("Attachment") then part = part.Parent end
    if part and part:IsA("BasePart") then return (part.Position - root.Position).Magnitude end
    return math.huge
end

local function triggerPrompt(prompt, data)
    if not prompt or not prompt.Parent then return false end
    if LocalPlayer:GetAttribute("Stealing") == true then return false end
    local invoked = false
    for _, callback in ipairs(data.trigger) do if pcall(callback) then invoked = true end end
    if not invoked and typeof(fireproximityprompt) == "function" then invoked = pcall(fireproximityprompt, prompt) end
    return invoked
end

local function executeV1(prompt)
    if V3New.busy or not prompt or not prompt.Parent then return end
    if LocalPlayer:GetAttribute("Stealing") == true then return end
    local data = getPromptCallbacks(prompt, V3New.data)
    if not data.ready then return end
    data.ready = false; V3New.busy = true; V3New.generation = V3New.generation + 1; local runGen = V3New.generation
    task.spawn(function()
        for _, callback in ipairs(data.hold) do task.spawn(callback) end
        local holdStart = tick()
        while V3New.busy and tick() - holdStart < CONFIG.HOLD_MIN do
            if runGen ~= V3New.generation then return end
            v1Progress = math.clamp((tick() - holdStart) / CONFIG.HOLD_MIN, 0, 1); task.wait(0.05)
        end
        if runGen ~= V3New.generation then return end
        v1Progress = 1
        local wasInRange = getPromptDistance(prompt) <= CONFIG.FIRE_RANGE
        while runGen == V3New.generation and prompt.Parent and CONFIG.AUTO_STEAL_ENABLED and LocalPlayer:GetAttribute("Stealing") ~= true do
            v1Progress = 1
            local promptDistance = getPromptDistance(prompt)
            if promptDistance > CONFIG.NEAR_TARGET_RANGE and tick() - holdStart > CONFIG.HOLD_MAX then break end
            if promptDistance <= CONFIG.FIRE_RANGE then
                if not wasInRange then
                    task.wait(CONFIG.ENTRY_DELAY)
                    if runGen ~= V3New.generation or not prompt.Parent or getPromptDistance(prompt) > CONFIG.FIRE_RANGE then task.wait(0.05); continue end
                end
                if triggerPrompt(prompt, data) then break end
            end
            task.wait(0.05)
        end
        V3New.busy = false; data.ready = true; v1Progress = 0
    end)
end

