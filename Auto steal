    StatsFrame.Size = UDim2.new(0, 45, 0, 20); StatsFrame.Position = UDim2.new(1, -95, 0, 2); StatsFrame.BackgroundTransparency = 1; StatsFrame.ZIndex = 3

    local FPSLabel = Instance.new("TextLabel", StatsFrame)
    FPSLabel.Size = UDim2.new(1, 0, 0.5, 0); FPSLabel.BackgroundTransparency = 1; FPSLabel.Text = "0 FPS"; FPSLabel.TextColor3 = Color3.fromRGB(50, 255, 50); FPSLabel.Font = Enum.Font.GothamBold; FPSLabel.TextSize = 10; FPSLabel.TextXAlignment = Enum.TextXAlignment.Right; FPSLabel.TextStrokeTransparency = 0

    local PingLabel = Instance.new("TextLabel", StatsFrame)
    PingLabel.Size = UDim2.new(1, 0, 0.5, 0); PingLabel.Position = UDim2.new(0, 0, 0.5, 0); PingLabel.BackgroundTransparency = 1; PingLabel.Text = "0 MS"; PingLabel.TextColor3 = Color3.fromRGB(255, 255, 0); PingLabel.Font = Enum.Font.GothamBold; PingLabel.TextSize = 10; PingLabel.TextXAlignment = Enum.TextXAlignment.Right; PingLabel.TextStrokeTransparency = 0

    -- BOTÓN DEL AIMBOT (A la derecha)
    local AimBtn = Instance.new("TextButton", ScreenGui)
    AimBtn.Size = UDim2.new(0, 50, 0, 50)
    AimBtn.Position = UDim2.new(1, -70, 0.5, -25)
    AimBtn.BackgroundColor3 = Color3.fromRGB(20, 25, 35)
    AimBtn.Text = "AIM\nOFF"
    AimBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    AimBtn.Font = Enum.Font.GothamBlack
    AimBtn.TextSize = 10
    Instance.new("UICorner", AimBtn).CornerRadius = UDim.new(1, 0)
    local AimStroke = Instance.new("UIStroke", AimBtn); AimStroke.Color = Color3.fromRGB(100, 100, 100); AimStroke.Thickness = 1.5

    -- Hacerlo arrastrable
    local dragging, dragInput, dragStart, startPos
    AimBtn.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; dragStart = input.Position; startPos = AimBtn.Position end end)
    AimBtn.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end end)
    UserInputService.InputChanged:Connect(function(input) if input == dragInput and dragging then local delta = input.Position - dragStart; AimBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y) end end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)

    AimBtn.MouseButton1Click:Connect(function()
        AimbotEnabled = not AimbotEnabled
        if AimbotEnabled then
            AimBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50); AimBtn.TextColor3 = Color3.fromRGB(255, 255, 255); AimStroke.Color = Color3.fromRGB(50, 200, 50)
            AimBtn.Text = "AIM\nON"
            startZurichAimbot(LocalPlayer.Character)
        else
            AimBtn.BackgroundColor3 = Color3.fromRGB(20, 25, 35); AimBtn.TextColor3 = Color3.fromRGB(200, 200, 200); AimStroke.Color = Color3.fromRGB(100, 100, 100)
            AimBtn.Text = "AIM\nOFF"
            stopZurichAimbot()
        end
    end)

    -- Lógica de FPS
    local frames = 0; local lastTime = tick()
    RunService.RenderStepped:Connect(function()
        frames = frames + 1; local now = tick()
        if now - lastTime >= 1 then FPSLabel.Text = math.floor(frames / (now - lastTime)) .. " FPS"; frames = 0; lastTime = now end
    end)

    -- Lógica de Ping
    task.spawn(function()
        while task.wait(2) do
            local ok, ping = pcall(function() return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() end)
            if ok and ping then PingLabel.Text = math.floor(ping) .. " MS" end
        end
    end)

    -- Actualización de la barra
    RunService.Heartbeat:Connect(function()
        local targetW = math.clamp(v1Progress * barBg.AbsoluteSize.X, 0, barBg.AbsoluteSize.X)
        barFill.Size = UDim2.new(0, targetW, 1, 0)
        percentLabel.Text = math.floor(v1Progress * 100) .. "%"
    end)
end

